# Copy to .env for local Compose. Never commit real secrets.

# PostgreSQL
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=ecommerce
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka
KAFKA_PORT=9092

# Mailhog
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Apps
BACKEND_PORT=8080
FRONTEND_PORT=3000
JWT_SECRET=local-dev-only-change-me-to-a-long-random-secret-key-32b
JWT_ISSUER=ecommerce-platform
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Stripe Test Mode placeholders only. Never put live keys or real secrets here.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_MOCK=false
